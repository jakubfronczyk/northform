-- v2 → v3 (D31, D32): the reliability log learns `bluetooth_off`, and `recoveries` becomes `crashes`.
-- The table is a cache of `ReliabilityRecord.of(load(id))`
-- and `ReliabilityRecord.version` was bumped with the rule, so every v2 row would be read as stale anyway: the
-- table is recreated empty rather than altered (no DEFAULT to carry into the fresh `.sq`); the next read
-- recomputes from the events. Must end at exactly what `Reliability.sq` creates fresh. Never edit once shipped.
-- `ReliabilityRecord.version` is the real invalidation (a row of another version is recomputed, not read); the
-- DROP is only safe because `reliability` is a cache: it holds nothing the events cannot rebuild. A table holding
-- primary data must be ALTERed or copied, never dropped.
DROP TABLE reliability;
CREATE TABLE reliability (
    recording_id TEXT NOT NULL PRIMARY KEY,
    version INTEGER NOT NULL,
    drops INTEGER NOT NULL,
    reconnects INTEGER NOT NULL,
    reconnect_times TEXT NOT NULL,
    hr_lost INTEGER NOT NULL,
    gps_lost INTEGER NOT NULL,
    crashes INTEGER NOT NULL,
    bluetooth_off INTEGER NOT NULL
);
